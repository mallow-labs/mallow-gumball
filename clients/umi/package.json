{
  "name": "@mallow-labs/mallow-gumball-umi",
  "version": "1.0.0-alpha.0",
  "description": "Umi client library for Gumball Machine related programs",
  "sideEffects": false,
  "module": "./dist/src/index.mjs",
  "main": "./dist/src/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.js"
    }
  },
  "files": [
    "./dist/src",
    "./dist/types"
  ],
  "scripts": {
    "build": "rimraf dist && tsup && tsc -p ./tsconfig.declarations.json",
    "build:docs": "typedoc",
    "dev": "tsup --watch",
    "pretest": "node -e \"if(Number(process.versions.node.split('.')[0])<24)throw new Error('Tests require Node >=24 (LiteSVM aborts with std::bad_alloc on Node 20/22); running '+process.version)\"",
    "test": "tsup && ava",
    "lint": "eslint --ext js,ts,tsx src",
    "lint:fix": "eslint --fix --ext js,ts,tsx src",
    "format": "prettier --check src test",
    "format:fix": "prettier --write src test",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://mallow.art",
  "repository": "https://github.com/mallow-labs/mallow-gumball.git",
  "author": "mallow labs <admin@mallow.art>",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@metaplex-foundation/umi": "^1.2.0"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.1.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.2.1",
    "@metaplex-foundation/mpl-toolbox": "^0.9.0",
    "@noble/hashes": "^1.2.0",
    "merkletreejs": "^0.5.2"
  },
  "devDependencies": {
    "@ava/typescript": "^4.1.0",
    "@identity.com/solana-gateway-ts": "^0.12.0",
    "@mallow-labs/mallow-jellybean-umi": "0.1.3",
    "@metaplex-foundation/mpl-bubblegum": "5.0.2",
    "@metaplex-foundation/mpl-token-auth-rules": "^3.0.3",
    "@metaplex-foundation/umi-bundle-tests": "^1.2.0",
    "@metaplex-foundation/umi-web3js-adapters": "^1.2.0",
    "@solana/spl-token": "0.3.9",
    "@solana/web3.js": "^1.73.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.46.1",
    "ava": "^6.1.3",
    "buffer": "^6.0.3",
    "eslint": "^8.0.1",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "litesvm": "1.3.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.1.2",
    "typedoc": "^0.25.12",
    "typedoc-plugin-expand-object-like-types": "^0.1.2",
    "typedoc-plugin-missing-exports": "^1.0.0",
    "typescript": "^5.8.3"
  },
  "ava": {
    "files": [
      "test/**/*.test.ts"
    ],
    "nodeArguments": [
      "--no-warnings"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "test/": "dist/test/"
      }
    }
  },
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=24"
  }
}
