{
	"private": true,
	"scripts": {
		"build": "pnpm programs:build && pnpm generate",
		"dev": "cd clients/js && pnpm dev",
		"programs:build": "./configs/program-scripts/build.sh",
		"programs:test": "./configs/program-scripts/test.sh",
		"programs:clean": "rm -rf ./programs/.bin",
		"generate": "pnpm generate:clients",
		"generate:clients": "node ./codama.mjs && pnpm --filter @mallow-labs/mallow-gumball format:fix",
		"test": "pnpm test:js",
		"test:js": "cd clients/js && pnpm test"
	},
	"devDependencies": {
		"@codama/nodes-from-anchor": "^1.5.0",
		"@codama/renderers-js-umi": "^1.1.0",
		"codama": "^1.8.0",
		"typescript": "^5.8.3"
	},
	"packageManager": "pnpm@10.9.0"
}
